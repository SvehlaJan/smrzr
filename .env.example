# Sentry DSN for the smrzr project (org jans-gi, EU region). Without it, Sentry is disabled.
# Put this one in .env.local (never committed; used by dev and production builds).
WXT_SENTRY_DSN=

# Optional, development builds only: prefills the Gemini API key so you don't have to paste it into settings.
# Put this one in .env.development.local (never committed; Vite loads it ONLY for `npm run dev`),
# so the key can never end up in a production build.
WXT_GEMINI_API_KEY=
